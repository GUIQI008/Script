[Script]
Pixiv会员 = type=http-response, pattern=^https:\\/\\/(?:app-api\\.pixiv\\.net\\/v2\\/user\\/detail|oauth\\.secure\\.pixiv\\.net\\/auth\\/token), requires-body=1, script-path=https://raw.githubusercontent.com/GUIQI008/Script/main/js/pixiv.js

[MITM]
hostname = %APPEND% oauth.secure.pixiv.net, app-api.pixiv.net
